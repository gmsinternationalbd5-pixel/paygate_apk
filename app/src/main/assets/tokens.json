{
  "theme": {
    "palette": {
      "bg": { "light": "#FAFAF9", "dark": "#0B0B0E", "usage": "Master application background" },
      "surface": { "light": "#FFFFFF", "dark": "#141418", "usage": "Primary cards, modals, table surfaces" },
      "surface-2": { "light": "#F4F4F2", "dark": "#1C1C22", "usage": "Inputs, table headers, hover highlights" },
      "border": { "light": "#E7E7E3", "dark": "#2A2A31", "usage": "1px hairline borders" },
      "ink": { "light": "#0E0E11", "dark": "#F5F5F7", "usage": "Primary text, primary CTA buttons" },
      "ink-2": { "light": "#55555E", "dark": "#A4A4AE", "usage": "Secondary text, subtle descriptions" },
      "ink-3": { "light": "#8A8A94", "dark": "#6F6F7A", "usage": "Placeholder text, captions, timestamps" },
      "accent": { "light": "#5B5BF0", "dark": "#8B8BFF", "usage": "Interactive links, active states, focus ring" },
      "accent-soft": { "light": "#EEEEFF", "dark": "#23234A", "usage": "Reference chip background, active tab pill" },
      "success": { "light": "#12B76A", "dark": "#32D583", "usage": "Verified payment, online status, KYB badge" },
      "warning": { "light": "#F79009", "dark": "#FDB022", "usage": "Needs review, limit warnings, pending payouts" },
      "danger": { "light": "#F04438", "dark": "#F97066", "usage": "Rejected, expired, error alerts" }
    },
    "brands": {
      "bkash": { "hex": "#E2136E", "usage": "bKash brand indicator dot and badge" },
      "nagad": { "hex": "#F6921E", "usage": "Nagad brand indicator dot and badge" },
      "rocket": { "hex": "#8C3494", "usage": "Rocket brand indicator dot and badge" }
    },
    "radii": {
      "input": "8px",
      "button": "12px",
      "card": "16px",
      "drawer": "24px",
      "pill": "9999px"
    },
    "hairline": "1px"
  }
}
